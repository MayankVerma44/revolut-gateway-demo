# Application
APP_BASE_URL=http://localhost:5173
PORT=3001
LOG_LEVEL=info

# Frontend (Vercel) — set in Vercel project env, not in this file
# VITE_API_URL=https://revolut-gateway-demo.onrender.com

# Revolut Merchant API
# Never expose REVOLUT_SECRET_KEY to the frontend.
#
# To use the Revolut Sandbox widget (embedded checkout):
# 1. Create a sandbox account: https://developer.revolut.com/docs/guides/merchant/test-and-go-live/set-up-sandbox
# 2. In Revolut Business → Developer → API keys, copy your sandbox keys
# 3. Paste keys below and restart: npm run dev
#
# Hosted checkout redirect_url targets /order/:id/success after payment.
# Sandbox rejects localhost — set a tunnel or public URL:
# REVOLUT_HOSTED_REDIRECT_URL=https://your-subdomain.ngrok-free.app
REVOLUT_PUBLIC_KEY=
REVOLUT_SECRET_KEY=
REVOLUT_MODE=sandbox
REVOLUT_API_VERSION=2026-04-20
REVOLUT_WEBHOOK_SECRET=
REVOLUT_HOSTED_REDIRECT_URL=
